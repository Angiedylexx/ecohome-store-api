# Plantilla de variables de entorno para la conexión a PostgreSQL
# Copia este archivo como ".env" y completa con tus credenciales reales.

DB_HOST=localhost
DB_USER=postgres
DB_PASS=postgres
DB_NAME=ecohome_store
DB_PORT=5432

# Puerto en el que corre el servidor Express
PORT=3000

# Clave secreta para firmar y verificar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
